APP_NAME="Government IDSS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=government_idss
DB_USERNAME=government_idss
DB_PASSWORD=
DB_SSLMODE=prefer
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# External integrations are disabled by default. Enable only after approved API contracts,
# provider credentials, data-sharing approval and test environments are supplied.
IDSS_UTAMBUZI_ENABLED=false
IDSS_UTAMBUZI_ADAPTER=
IDSS_SMS_ENABLED=false
IDSS_SMS_ADAPTER=
IDSS_EMAIL_ENABLED=false
IDSS_EMAIL_ADAPTER=App\\Integrations\\EmailNotificationAdapter

# Local Codespaces development uses SQLite. For production, set DB_CONNECTION=pgsql
# and provide PostgreSQL 14+ with PostGIS enabled by the database administrator.
DB_DATABASE=database/government_idss.sqlite

# Reverse proxy addresses must be explicitly configured in production.
TRUSTED_PROXIES=127.0.0.1,::1

# Operational security and private database backups.
IDSS_HSTS_ENABLED=false
IDSS_BACKUP_PATH=
IDSS_BACKUP_KEEP_DAYS=30
IDSS_BACKUP_TIME=02:00
IDSS_PG_DUMP_BINARY=pg_dump
IDSS_PG_RESTORE_BINARY=pg_restore
